{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interpretive-governance.org/schemas/agentic-reference/runtime.schema.json",
  "title": "RuntimeConfig",
  "type": "object",
  "required": [
    "temperature",
    "top_p",
    "max_tokens"
  ],
  "properties": {
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  },
  "additionalProperties": false
}